{
  "steps": [
    {
      "id": "download-scenario-data",
      "command": "csm-data",
      "arguments": [
        "api",
        "run-load-data"
      ],
      "useSystemEnvironment": true
    },
    {
      "id": "Calculator",
      "description": "Calculator Runtemplate",
      "command": "python",
      "arguments": [
        "code/run_templates/Calculator/main.py"
      ],
      "useSystemEnvironment": true,
      "precedents": [
        "download-scenario-data"
      ]
    },
    {
      "id": "load-store",
      "command": "csm-data",
      "arguments": [
        "store",
        "load-csv-folder",
        "--csv-folder",
        "/pkg/share/Simulation/Output"
      ],
      "useSystemEnvironment": true,
      "precedents": [
        "Calculator"
      ]
    },
    {
      "id": "send-results-store",
      "command": "csm-data",
      "arguments": [
        "store",
        "output"
      ],
      "useSystemEnvironment": true,
      "precedents": [
        "load-store"
      ]
    }
  ]
}